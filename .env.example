# convert2edt environment (copy to .env and adjust)
# Everything here is optional; versions are auto-detected inside the image.

# --- configuration storage (storage-* commands) --------------------------------
# Path on the host to the 1C configuration storage directory (1cv8ddb.1CD),
# mounted read-only as /storage:
# STORAGE_HOST_PATH=E:/crs/gitsync

# --- сборка образа: дистрибутивы и родительские (upstream) источники ----------
# Каталог с закрытыми дистрибутивами 1С (подаётся в сборку как named context,
# в образ не попадают; см. vendor/README.md):
# VENDOR_DIR=D:/dists/1c
# Родительский базовый образ:
# BASE_IMAGE=debian:bookworm-slim
# Коммит e8tools/tool1cd для сборки ctool1cd ( depot ver100 — с 625ac1a ):
# TOOL1CD_REF=625ac1a47b6ed63bba2848842daf1909813f84d4
# Движок gitsync в образе (oscript + gitsync + плагин edtExport):
# GITSYNC_SUPPORT=1
# OSCRIPT_VERSION=1.9.4
# MAC контейнера: программная лицензия 1С привязывается к MAC — не менять
# после получения лицензии через `converter license-gui`:
# V8_MAC_ADDRESS=02:42:AC:11:00:99

# --- labels of the built docker image ----------------------------------------
PLATFORM_VERSION=8.3.27.2342
EDT_VERSION=2026.1.3

# EDT platform support version to KEEP in the image (major.minor.patch);
# older platform-support components are uninstalled to keep the image slim.
EDT_PLATFORM_SUPPORT=8.3.27

# --- converter behaviour ------------------------------------------------------
# Platform version passed to 1cedtcli import (--version); empty = auto-detect
# from /opt/1cv8/current.
V8_VERSION=

# 1 = wipe destination XML/EDT directory before export (V8_CONF_CLEAN_DST analog)
CONVERT_CLEAN_DST=0

# 1 = always keep temporary files (debug)
CONVERT_KEEP_TEMP=0

# EDT JVM heap
CONVERT_EDT_XMX=2g

# 1cedtcli timeout, seconds
CONVERT_EDT_TIMEOUT=1800

# --- infobase credentials (client/server scenarios) ---------------------------
# Never put real passwords in .env for shared machines: use *_FILE secrets.
V8_IB_USER=
V8_IB_PWD=
# V8_IB_PWD_FILE=/run/secrets/ib_pwd

V8_DB_SRV_DBMS=PostgreSQL
V8_DB_SRV_USR=
V8_DB_SRV_PWD=
# V8_DB_SRV_PWD_FILE=/run/secrets/db_pwd
