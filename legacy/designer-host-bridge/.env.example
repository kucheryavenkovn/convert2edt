# =====================================================================
# crs2edt: хранилище 1С -> gitsync -> ibcmd -> EDT -> git monorepo
# Скопировать в .env и заполнить. Секреты — в .secrets/ (не коммитить!).
# =====================================================================

# --- Вариант B: Windows Host Bridge (основной) --------------------------
# Windows один раз: host\install-service.ps1 + host\doctor.ps1 (см. host/README.md)
BRIDGE_URL=http://host.docker.internal:17833
# токен моста: файл .secrets/bridge_token (должен совпадать с host bridge_config.json)
# общий staging: каталог на Windows-хосте, монтируется в контейнер как /bridge
BRIDGE_HOST_PATH=E:/1c-bridge

# --- Платформа / EDT / компоненты (версии сборки образа) ---------------
# Версия платформы Windows-хоста (для информации; ibcmd в контейнере из deb64)
PLATFORM_VERSION=8.3.27.2342
ONEC_PLATFORM_SUPPORT=8.3.27
EDT_VERSION=2026.1.3
OSCRIPT_VERSION=1.9.3
GITSYNC_VERSION=3.8.0
CONVERTER_DOCKERFILE=Dockerfile.bridge

# --- Образ --------------------------------------------------------------
IMAGE_NAME=crs2edt/converter-bridge
IMAGE_TAG=latest

# --- Хранилище 1С --------------------------------------------------------
# Путь на Windows-хосте. Внутри контейнера всегда /storage.
STORAGE_HOST_PATH=E:/crs/gitsync
STORAGE_USER=Администратор
# пароль хранилища: файл .secrets/storage_password

# --- Git / monorepo ------------------------------------------------------
GIT_REMOTE=ssh://git@gitea.company.local/1c/project.git
GIT_BRANCH=main
PROJECT_PATH=configuration/main
PROJECT_NAME=main

# --- Runtime --------------------------------------------------------------
ONEC_VERSION_MASK=8.3
IBCMD_THREADS=8
INCREMENTAL=true
MIGRATE_BATCH_LIMIT=500
DOMAIN_EMAIL=company.local

# --- Вариант A (отложен): identity для лицензии в Docker ----------
ONEC_HOSTNAME=onec-gitsync
ONEC_MAC_ADDRESS=02:42:ac:1e:00:99
# NETHASP_INI_PATH=./config/nethasp.ini
